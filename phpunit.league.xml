<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd"
    colors="true"
    bootstrap="vendor/autoload.php"
    failOnDeprecation="true"
    failOnPhpunitDeprecation="true"
    failOnNotice="true"
    failOnWarning="true"
>
    <php>
        <server name="KERNEL_CLASS" value="Ajgarlag\Bundle\OpenIDConnectProviderBundle\Tests\League\LeagueTestKernel" />
        <env name="SYMFONY_PHPUNIT_VERSION" value="11.5"/>
    </php>
    <testsuites>
        <testsuite name="league">
            <directory>./tests/League</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
    <extensions>
        <bootstrap class="Symfony\Bridge\PhpUnit\SymfonyExtension" />
    </extensions>
</phpunit>
